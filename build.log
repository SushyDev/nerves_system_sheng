parts="crtbegin.o crtbeginS.o crtbeginT.o crtend.o crtendS.o crtfastmath.o";					\
for file in $parts; do					\
  rm -f ../.././gcc/$file;		\
  /usr/bin/install -c -m 644 $file ../.././gcc/;	\
  case $file in 					\
    *.a)						\
      /home/nerves/project/host/aarch64-buildroot-linux-gnu/bin/ranlib ../.././gcc/$file ;;	\
  esac;							\
done
