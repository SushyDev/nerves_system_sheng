# Xiaomi Pad 6S Pro (SM8550) - Nerves System Configuration
BR2_aarch64=y
BR2_CORTEX_A76=y
BR2_ARM_FPU_NEON=y

# Linux Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_GIT_REPO_URL="https://github.com/ianchb/sm8550-mainline.git"
BR2_LINUX_KERNEL_CUSTOM_GIT_VERSION="sheng-7.1"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/xiaomi_sheng/sm8550.config"

# Device Tree
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="qcom/sm8550-xiaomi-sheng"

# Firmware
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_QCOM_ADRENO=y
BR2_PACKAGE_LINUX_FIRMWARE_QCOM_MODEM=y
BR2_PACKAGE_LINUX_FIRMWARE_QCOM_AUDIO=y

# Toolchain
BR2_TOOLCHAIN_BUILDROOT_LLVM=y
BR2_GCC_ENABLE_LTO=y

# Root filesystem
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_SIZE="1G"

# System utilities
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_OPENSSH=y
