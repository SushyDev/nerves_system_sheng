# erlinit.config for Xiaomi Pad 6S Pro (sheng)

# hostname must start with "nerves"/"nerves-" or `mix nerves.discover` filters
# it out, even though Buildroot's default "buildroot" hostname is reachable/SSH-able
-n nerves-sheng

# boot signals before the Erlang VM starts: LED blink = erlinit/userspace alive,
# audio beep = audio subsystem working. No blink = stuck in kernel/bootloader.
-c /usr/bin/boot-led-blink.sh

# no udev/mdev on Nerves to auto-load ath12k/audio drivers; must run before boot-beep.sh
-c /usr/bin/load-hw-modules.sh

-c /usr/bin/boot-beep.sh

# TEMPORARY: keep board reachable (not rebooting) on Erlang VM crash while
# debugging boot. Remove once boot is confirmed stable.
--hang-on-exit
--hang-on-fatal