# Pre-Erlang, deliberately: watchdog module load + GPT retry-count reset
# both need to happen even if Erlang itself never comes up this boot. See
# pre-erlang-init.sh - erlinit blocks on this, so nothing slow/hang-risk
# belongs here (WiFi/audio stay post-Erlang in HardwareModules.load!/0).
-c /usr/bin/pre-erlang-init.sh
